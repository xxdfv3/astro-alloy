---
// Header.astro - Шапка сайта
---

<header class="header">
  <div class="container">
    <div class="header__inner">
      <!-- Логотип -->
      <a href="/" class="header__logo">
        <div class="header__logo-icon">
          <span>ПК</span>
        </div>
        <div class="header__logo-text">
          <h1>ПечныеКомплексы</h1>
          <p>Промышленное оборудование</p>
        </div>
      </a>

      <!-- Навигация для десктопа -->
      <nav class="header__nav">
        <a href="/catalog" class="header__nav-link">Каталог</a>
        <a href="/services" class="header__nav-link">Услуги</a>
        <a href="/about" class="header__nav-link">О компании</a>
        <a href="/contacts" class="header__nav-link">Контакты</a>
      </nav>

      <!-- Контакты и кнопка -->
      <div class="header__contacts">
        <div class="header__phone">
          <a href="tel:+78001234567">8 (800) 123-45-67</a>
          <p>Бесплатно по России</p>
        </div>
        <a href="/contacts" class="header__btn">Заказать</a>
      </div>

      <!-- Мобильное меню кнопка -->
      <button id="mobile-menu-btn" class="header__mobile-btn" aria-label="Открыть меню">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Мобильное меню -->
    <div id="mobile-menu" class="header__mobile-menu">
      <nav class="header__mobile-nav">
        <a href="/catalog" class="header__mobile-link">Каталог</a>
        <a href="/services" class="header__mobile-link">Услуги</a>
        <a href="/about" class="header__mobile-link">О компании</a>
        <a href="/contacts" class="header__mobile-link">Контакты</a>
        <a href="tel:+78001234567" class="header__mobile-phone">8 (800) 123-45-67</a>
        <a href="/contacts" class="header__mobile-btn-action">Заказать</a>
      </nav>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('active');
  });
</script>

<style>
  .header {
    background-color: #0F3D66;
    color: white;
    position: sticky;
    top: 0;
    z-index: 50;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 80px;
  }

  .header__logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: white;
  }

  .header__logo-icon {
    width: 48px;
    height: 48px;
    background-color: white;
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .header__logo-icon span {
    color: #0F3D66;
    font-weight: bold;
    font-size: 1.25rem;
  }

  .header__logo-text h1 {
    font-size: 1.25rem;
    font-weight: bold;
    margin: 0;
  }

  .header__logo-text p {
    font-size: 0.75rem;
    color: #D1D5DB;
    margin: 0;
  }

  .header__nav {
    display: none;
    align-items: center;
    gap: 2rem;
  }

  .header__nav-link {
    color: white;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .header__nav-link:hover {
    color: #0B2E4D;
  }

  .header__contacts {
    display: none;
    align-items: center;
    gap: 1.5rem;
  }

  .header__phone {
    text-align: right;
  }

  .header__phone a {
    display: block;
    font-size: 1.125rem;
    font-weight: bold;
    color: white;
    text-decoration: none;
    transition: color 0.2s;
  }

  .header__phone a:hover {
    color: #D1D5DB;
  }

  .header__phone p {
    font-size: 0.75rem;
    color: #D1D5DB;
    margin: 0;
  }

  .header__btn {
    background-color: #C2410C;
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    text-decoration: none;
    font-weight: 600;
    transition: background-color 0.2s;
  }

  .header__btn:hover {
    background-color: #9A3412;
  }

  .header__mobile-btn {
    display: block;
    padding: 0.5rem;
    background: none;
    border: none;
    color: white;
    cursor: pointer;
  }

  .header__mobile-menu {
    display: none;
    padding-bottom: 1rem;
  }

  .header__mobile-menu.active {
    display: block;
  }

  .header__mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .header__mobile-link {
    color: white;
    text-decoration: none;
    padding: 0.5rem 0;
    transition: color 0.2s;
  }

  .header__mobile-link:hover {
    color: #D1D5DB;
  }

  .header__mobile-phone {
    font-size: 1.125rem;
    font-weight: bold;
    color: white;
    text-decoration: none;
    padding: 0.5rem 0;
  }

  .header__mobile-btn-action {
    background-color: #C2410C;
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    text-decoration: none;
    font-weight: 600;
    text-align: center;
    transition: background-color 0.2s;
  }

  .header__mobile-btn-action:hover {
    background-color: #9A3412;
  }

  @media (min-width: 768px) {
    .header__nav {
      display: flex;
    }

    .header__contacts {
      display: flex;
    }

    .header__mobile-btn {
      display: none;
    }

    .header__mobile-menu {
      display: none !important;
    }
  }
</style>