---
// Header.astro - Шапка сайта
import ConsultationModal from '../components/ConsultationModal.astro';
---

<header class="header">
  <div class="container">
    <div class="header__inner">
      <!-- Логотип -->
      <a href="/" class="header__logo">
        <img src="/logo.svg" alt="VZ Логотип" class="header__logo-img" />
        <div class="header__logo-text">
          <h1>VZmarket</h1>
          <p>Промышленное оборудование</p>
        </div>
      </a>

      <!-- Навигация для десктопа (от 1024px) -->
      <nav class="header__nav">
        <a href="/catalog" class="header__nav-link">Каталог</a>
        <a href="/about" class="header__nav-link">О компании</a>
        <a href="/contacts" class="header__nav-link">Контакты</a>
      </nav>

      <!-- Контакты и кнопка для десктопа -->
      <div class="header__contacts">
        <div class="header__phone">
          <a href="tel:+77066300404">8 (706) 630-04-04</a>
        </div>
        <button id="open-modal-btn" class="header__btn open-modal-btn" data-product="Заявка из шапки сайта (Десктоп)">Заказать</button>
      </div>

      <!-- Мобильное меню кнопка -->
      <button id="mobile-menu-btn" class="header__mobile-btn" aria-label="Открыть меню" aria-expanded="false">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Полноэкранное мобильное меню -->
    <div id="mobile-menu" class="header__mobile-menu">
      <button id="mobile-menu-close" class="header__mobile-close" aria-label="Закрыть меню">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <div class="header__mobile-overlay">
        <nav class="header__mobile-nav">
          <a href="/catalog" class="header__mobile-link">Каталог оборудования</a>
          <a href="/services" class="header__mobile-link">Наши услуги</a>
          <a href="/about" class="header__mobile-link">О компании</a>
          <a href="/contacts" class="header__mobile-link">Контакты</a>
          
          <div class="header__mobile-divider"></div>
          
          <div class="header__mobile-phone-block">
            <a href="tel:+77066300404" class="header__mobile-phone">8 (706) 630-04-04</a>
          </div>
          
          <!-- ТА ЖЕ КНОПКА, ЧТО В ОРИГИНАЛЕ -->
          <button id="open-modal-btn" class="header__btn open-modal-btn" data-product="Заявка из шапки сайта (Мобильный)">Заказать</button>
        </nav>
      </div>
    </div>
  </div>
  <ConsultationModal />
</header>

<script is:inline>
  (function() {
    const btn = document.getElementById('mobile-menu-btn');
    const closeBtn = document.getElementById('mobile-menu-close');
    const menu = document.getElementById('mobile-menu');
    
    const openMenu = () => {
      menu?.classList.add('active');
      btn?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    };

    const closeMenu = () => {
      menu?.classList.remove('active');
      btn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    };

    btn?.addEventListener('click', openMenu);
    closeBtn?.addEventListener('click', closeMenu);

    // Закрываем меню при клике на ссылки
    document.querySelectorAll('.header__mobile-link, .header__mobile-phone').forEach(link => {
      link?.addEventListener('click', closeMenu);
    });

    // Клик на фон
    menu?.addEventListener('click', (e) => {
      if (e.target === menu) closeMenu();
    });

    // Ресайз
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024 && menu?.classList.contains('active')) closeMenu();
    });

    // Escape
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu?.classList.contains('active')) closeMenu();
    });
  })();
</script>

<style>
  :root {
    --header-height: 64px;
    --pad-x: 1rem;
    --container-max: 100%;
    --logo-size: 40px;
    --h1-size: 1.1rem;
    --p-size: 0.7rem;
  }

  @media (min-width: 576px) {
    :root { --header-height: 72px; --pad-x: 1.5rem; --logo-size: 44px; }
  }

  @media (min-width: 768px) {
    :root { --header-height: 76px; --pad-x: 2rem; --logo-size: 46px; --h1-size: 1.25rem; --p-size: 0.75rem; }
  }

  @media (min-width: 1024px) {
    :root { --header-height: 80px; --pad-x: 2.5rem; --container-max: 1024px; --logo-size: 48px; }
  }

  @media (min-width: 1280px) {
    :root { --header-height: 84px; --pad-x: 3rem; --container-max: 1280px; }
  }

  @media (min-width: 1600px) {
    :root { --header-height: 90px; --pad-x: 4rem; --container-max: 1520px; }
  }

  .header {
    background-color: #0F3D66;
    color: white;
    position: sticky;
    top: 0;
    z-index: 50;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    font-family: system-ui, -apple-system, sans-serif;
  }

  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--pad-x);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
    gap: 1rem;
  }

  .header__logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: white;
    flex-shrink: 0;
  }

  .header__logo-img {
    width: var(--logo-size);
    height: var(--logo-size);
    display: block;
  }

  .header__logo-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    line-height: 1.2;
  }

  .header__logo-text h1 {
    font-size: var(--h1-size);
    font-weight: 700;
    margin: 0;
    letter-spacing: 0.5px;
  }

  .header__logo-text p {
    font-size: var(--p-size);
    color: #D1D5DB;
    margin: 0;
    font-weight: 400;
    letter-spacing: 0.5px;
  }

  .header__nav {
    display: none;
    align-items: center;
    gap: 2rem;
  }

  .header__nav-link {
    color: white;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
    white-space: nowrap;
  }

  .header__nav-link:hover {
    color: #0B2E4D;
  }

  .header__contacts {
    display: none;
    align-items: center;
    gap: 1.5rem;
  }

  .header__phone {
    text-align: right;
  }

  .header__phone a {
    display: block;
    font-size: 1.125rem;
    font-weight: bold;
    color: white;
    text-decoration: none;
    transition: color 0.2s;
    white-space: nowrap;
  }

  .header__phone a:hover {
    color: #D1D5DB;
  }

  .header__phone p {
    font-size: 0.75rem;
    color: #D1D5DB;
    margin: 0;
  }

  .header__btn {
    background-color: #C2410C;
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    text-decoration: none;
    font-weight: 600;
    transition: background-color 0.2s;
    border: none;
    cursor: pointer;
    font-family: inherit;
    font-size: 1rem;
    white-space: nowrap;
  }

  .header__btn:hover {
    background-color: #9A3412;
  }

  .header__mobile-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 0.5rem;
    color: white;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.2s;
  }

  .header__mobile-btn:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  .header__mobile-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    color: white;
    cursor: pointer;
    transition: all 0.2s;
    z-index: 101;
  }

  .header__mobile-close:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: rotate(90deg);
  }

  .header__mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    height: 100dvh;
    background-color: rgba(15, 61, 102, 0.98);
    backdrop-filter: blur(8px);
    z-index: 100;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }

  .header__mobile-menu.active {
    opacity: 1;
    visibility: visible;
  }

  .header__mobile-overlay {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 2rem;
  }

  .header__mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: center;
    max-width: 400px;
    width: 100%;
  }

  .header__mobile-link {
    color: white;
    text-decoration: none;
    font-size: 1.375rem;
    font-weight: 500;
    padding: 1.25rem 1rem;
    transition: all 0.2s;
    border-radius: 0.75rem;
  }

  .header__mobile-link:hover {
    color: #D1D5DB;
    background: rgba(255, 255, 255, 0.05);
  }

  .header__mobile-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.15);
    margin: 1rem 0;
  }

  .header__mobile-phone-block {
    margin: 1rem 0;
  }

  .header__mobile-phone {
    font-size: 1.625rem;
    font-weight: 700;
    color: white;
    text-decoration: none;
    display: block;
    margin-bottom: 0.5rem;
    transition: color 0.2s;
  }

  .header__mobile-phone:hover {
    color: #60A5FA;
  }

  .header__mobile-desc {
    display: block;
    color: #9CA3AF;
    font-size: 0.9375rem;
  }

  .header__btn--mobile {
    width: 100%;
    padding: 1.25rem;
    font-size: 1.125rem;
    margin-top: 1rem;
  }

  @media (min-width: 1024px) {
    .header__nav { display: flex; }
    .header__contacts { display: flex; }
    .header__mobile-btn { display: none; }
    .header__mobile-menu { display: none !important; }
  }

  @media (max-width: 1023px) {
    .header__nav { display: none !important; }
    .header__contacts { display: none !important; }
  }
</style>