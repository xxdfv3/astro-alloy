<style>
  .footer {
    background-color: #0F3D66;
    color: white;
    margin-top: 4rem;
    padding: 4rem 0;
    font-family: system-ui, -apple-system, sans-serif;
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Сетка из 4 колонок */
  .footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  /* Колонка 1: Бренд и логотип */
  .footer__col--brand {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .footer__logo-link {
    display: inline-block;
    margin-bottom: 2rem;
  }

  .footer__logo {
    display: block;
    max-width: 160px;
    height: auto;
    max-height: 80px;
  }

  .footer__brand-bottom {
    margin-top: auto;
  }

  .footer__copyright {
    color: #9CA3AF;
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 0 0 0.5rem 0;
  }

  /* Общие стили секций */
  .footer__title {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: white;
  }

  /* Списки навигации */
  .footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer__link {
    color: #D1D5DB;
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .footer__link:hover {
    color: white;
  }

  .footer__link--privacy {
    font-size: 0.875rem;
    text-decoration: underline;
    text-decoration-color: rgba(209, 213, 219, 0.3);
    text-underline-offset: 4px;
  }

  /* Блоки с текстом */
  .footer__info-group {
    margin-bottom: 1.5rem;
  }

  .footer__info-group:last-child {
    margin-bottom: 0;
  }

  .footer__label {
    display: block;
    font-size: 0.8rem;
    color: #9CA3AF;
    margin-bottom: 0.25rem;
  }

  .footer__text {
    color: #D1D5DB;
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
  }

  /* Правая колонка с контактами и соцсетями */
  .footer__phones {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .footer__phone, .footer__email {
    color: white;
    text-decoration: none;
    font-size: 1.125rem;
    font-weight: 600;
    transition: color 0.2s;
  }

  .footer__email {
    font-size: 0.95rem;
    font-weight: 400;
    color: #D1D5DB;
  }

  .footer__phone:hover, .footer__email:hover {
    color: #60A5FA;
  }

  /* Социальные сети - стиль с тонкими кругами */
  .footer__social-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer__social {
    display: flex;
    gap: 0.75rem;
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    color: white;
    transition: all 0.3s ease;
  }

  .footer__social-link:hover {
    border-color: white;
    background-color: rgba(255, 255, 255, 0.1);
    transform: translateY(-2px);
  }

  /* Адаптивность для планшетов */
  @media (min-width: 768px) {
    .footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Адаптивность для десктопов (4 колонки) */
  @media (min-width: 1024px) {
    .footer__grid {
      /* Пропорции: 1.2 доли под логотип, по 1 доле на навигацию/контакты, 1.2 на телефоны */
      grid-template-columns: 1.2fr 1fr 1fr 1.2fr;
    }
  }
</style>