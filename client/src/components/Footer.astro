<style>
  :root {
    --footer-bg: #0F3D66;
    --footer-text: #D1D5DB;
    --footer-text-muted: #9CA3AF;
    --footer-accent: #60A5FA;
    --footer-padding-y: 1.25rem;
  }

  .footer {
    background-color: var(--footer-bg);
    color: #ffffff;
    margin-top: auto;
    padding: var(--footer-padding-y) 0;
    font-family: 'PT Astra Sans', 'Liberation Sans', system-ui, -apple-system, sans-serif;
    font-size: 0.875rem;
  }

  .container {
    width: 100%;
    max-width: 100%;
    padding: 0 clamp(1rem, 4vw, 4rem);
    margin: 0 auto;
  }

  /* Сетка: по умолчанию 1 колонка (мобильные) */
  .footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    text-align: center;
  }

  /* === ДЕСКТОП: смещение на 60px и компактные отступы === */
  @media (min-width: 768px) {
    .footer__grid {
      /* 5 колонок: 60px отступ | 3 колонки контента | 60px отступ */
      grid-template-columns: 60px 1fr 1fr 1fr 60px;
      align-items: center;
      column-gap: 2rem; /* Расстояние между колонками */
      row-gap: 0.5rem;  /* Минимальное расстояние до нижней панели */
      text-align: left;
    }

    /* Позиционирование колонок */
    .footer__col--left {
      grid-column: 2;
      text-align: left;
    }
    .footer__col--center {
      grid-column: 3;
      text-align: center;
    }
    .footer__col--right {
      grid-column: 4;
      text-align: right;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
    }
    .footer__col--right .footer__social {
      justify-content: flex-end;
    }
  }

  /* Мобильная адаптация */
  @media (max-width: 767px) {
    .footer__col--right {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .footer__social {
      justify-content: center;
    }
  }

  .footer__info-group {
    margin-bottom: 0.5rem;
  }
  .footer__info-group:last-child {
    margin-bottom: 0;
  }

  .footer__label {
    display: block;
    font-size: 0.7rem;
    color: var(--footer-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.2rem;
    font-weight: 600;
  }

  .footer__text {
    color: var(--footer-text);
    margin: 0;
    line-height: 1.3;
    font-size: 0.85rem;
  }

  .footer__divider {
    color: rgba(255, 255, 255, 0.3);
    margin: 0 0.4rem;
  }

  .footer__phone {
    display: block;
    color: #ffffff;
    text-decoration: none;
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.2;
    transition: color 0.2s;
  }

  .footer__email {
    color: var(--footer-text);
    text-decoration: none;
    font-size: 0.85rem;
    transition: color 0.2s;
  }

  .footer__phone:hover,
  .footer__email:hover {
    color: var(--footer-accent);
  }

  .footer__social {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    color: #ffffff;
    transition: all 0.2s ease;
  }

  .footer__social-link:hover {
    border-color: var(--footer-accent);
    color: var(--footer-accent);
    background-color: rgba(255, 255, 255, 0.05);
  }

  /* === НИЖНЯЯ ПАНЕЛЬ (максимально приближена к колонкам) === */
  .footer__bottom {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;    /* Уменьшено */
    padding-top: 0.75rem;  /* Уменьшено */
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (min-width: 768px) {
    .footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      margin-top: 0.5rem;    /* Уменьшено с 1.25rem */
      padding-top: 0.75rem;  /* Уменьшено с 1.25rem */
    }
  }

  .footer__copyright {
    color: var(--footer-text-muted);
    font-size: 0.8rem;
    margin: 0;
    line-height: 1.2;
  }

  .footer__link--privacy {
    color: var(--footer-text-muted);
    font-size: 0.8rem;
    text-decoration: underline;
    text-decoration-color: rgba(209, 213, 219, 0.3);
    text-underline-offset: 3px;
    transition: color 0.2s, text-decoration-color 0.2s;
  }

  .footer__link--privacy:hover {
    color: #ffffff;
    text-decoration-color: #ffffff;
  }
</style>