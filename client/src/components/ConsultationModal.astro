---
// Компонент модального окна в стиле index.astro
---
<div id="consultation-modal" class="modal-overlay">
  <div class="modal-content">

    <button id="close-modal-btn" class="close-btn">&times;</button>

    <h2>Заказать консультацию</h2>

    <form id="lead-form" class="form">
      <input type="hidden" id="lead-interest" name="interest" value="" />

      <div class="form__group">
        <label for="lead-name" class="form__label">Ваше имя *</label>
        <input
          type="text"
          id="lead-name"
          name="name"
          required
          class="form__input"
          placeholder="Иван Иванов"
        />
      </div>

      <div class="form__group">
        <label for="lead-phone" class="form__label">Телефон *</label>
        <input
          type="tel"
          id="lead-phone"
          name="phone"
          required
          class="form__input"
          placeholder="+7 (___) ___-__-__"
          pattern="\+7\s\(\d{3}\)\s\d{3}-\d{2}-\d{2}"
          title="Введите номер в формате +7 (XXX) XXX-XX-XX"
        />
      </div>

      <div class="form__group">
        <label for="lead-comment" class="form__label">Комментарий</label>
        <textarea
          id="lead-comment"
          name="comment"
          rows="4"
          class="form__textarea"
          placeholder="Опишите ваш вопрос или задачу..."
        ></textarea>
      </div>

      <button type="submit" class="btn btn--primary btn--full">
        Отправить заявку
      </button>

      <p id="form-message" class="form-message"></p>
    </form>
  </div>
</div>

<style>
  /* === БАЗОВЫЕ СТИЛИ ОКНА === */
  .modal-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    z-index: 9999;
    justify-content: center;
    align-items: center;
    backdrop-filter: blur(2px);
  }

  .modal-overlay.show {
    display: flex;
  }

  .modal-content {
    background-color: #ffffff;
    padding: 2rem;
    border-radius: 0.75rem;
    width: 90%;
    max-width: 500px;
    position: relative;
    box-shadow: 0 10px 25px rgba(0,0,0,0.2);
    font-family: sans-serif;
  }

  .close-btn {
    position: absolute;
    top: 15px;
    right: 20px;
    font-size: 28px;
    background: none;
    border: none;
    cursor: pointer;
    color: #888;
    line-height: 1;
  }

  .close-btn:hover {
    color: #111827;
  }

  .modal-content h2 {
    margin-top: 0;
    margin-bottom: 1.5rem;
    font-size: 1.5rem;
    font-weight: bold;
    text-align: center;
    color: #111827;
  }

  /* === СТИЛИ ФОРМЫ ИЗ INDEX.ASTRO === */
  .form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form__group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .form__label {
    font-size: 0.875rem;
    font-weight: 600;
    color: #111827;
  }

  .form__input,
  .form__textarea {
    padding: 0.75rem 1rem;
    border: 1px solid #DCE3EB;
    border-radius: 0.5rem;
    font-size: 1rem;
    font-family: inherit;
    transition: border-color 0.2s, box-shadow 0.2s;
    background-color: #F9FAFB;
    width: 100%;
    box-sizing: border-box;
  }

  .form__input:focus,
  .form__textarea:focus {
    outline: none;
    border-color: #0F3D66;
    box-shadow: 0 0 0 3px rgba(15, 61, 102, 0.1);
    background-color: #FFFFFF;
  }

  .form__textarea {
    resize: vertical;
    min-height: 100px;
  }

  .btn {
    display: inline-block;
    padding: 0.875rem 1.75rem;
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 1.125rem;
    text-align: center;
    transition: all 0.2s;
    border: none;
    cursor: pointer;
  }

  .btn--primary {
    background-color: #C2410C;
    color: white;
  }

  .btn--primary:hover {
    background-color: #9A3412;
  }

  .btn--full {
    width: 100%;
  }

  .form-message {
    display: none;
    text-align: center;
    margin-top: 15px;
    font-size: 14px;
    font-weight: bold;
  }

  .form-message.success { display: block; color: #2e7d32; }
  .form-message.error { display: block; color: #c62828; }
</style>

<script>
  const modal = document.getElementById('consultation-modal');
  const closeBtn = document.getElementById('close-modal-btn');
  const form = document.getElementById('lead-form');
  const interestInput = document.getElementById('lead-interest') as HTMLInputElement;
  const messageEl = document.getElementById('form-message');
  const phoneInput = document.getElementById('lead-phone') as HTMLInputElement;

  // === ЛОГИКА ОТКРЫТИЯ И ЗАКРЫТИЯ ===
  const setupModal = () => {
    const openButtons = document.querySelectorAll('#open-modal-btn');

    openButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const product = (e.currentTarget as HTMLButtonElement).getAttribute('data-product');
        if (product && interestInput) {
          interestInput.value = product;
        }
        modal?.classList.add('show');
      });
    });
  };

  const closeModal = () => {
    modal?.classList.remove('show');
    (form as HTMLFormElement)?.reset();
    if(messageEl) messageEl.className = 'form-message';
  };

  closeBtn?.addEventListener('click', closeModal);

  window.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  // === МАСКА ТЕЛЕФОНА ===
  if (phoneInput) {
    const formatPhone = (value: string) => {
      const numbers = value.replace(/\D/g, '');
      if (!numbers) return '';

      let cleanNumbers = numbers;
      if (cleanNumbers.startsWith('8') || cleanNumbers.startsWith('7')) {
        cleanNumbers = cleanNumbers.substring(1);
      }

      const limitedNumbers = cleanNumbers.substring(0, 10);
      let formatted = '+7';

      if (limitedNumbers.length > 0) formatted += ' (' + limitedNumbers.substring(0, 3);
      if (limitedNumbers.length >= 4) formatted += ') ' + limitedNumbers.substring(3, 6);
      if (limitedNumbers.length >= 7) formatted += '-' + limitedNumbers.substring(6, 8);
      if (limitedNumbers.length >= 9) formatted += '-' + limitedNumbers.substring(8, 10);

      return formatted;
    };

    phoneInput.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement;
      const oldValue = target.value;
      const newValue = formatPhone(oldValue);
      target.value = newValue;

      if (target.selectionStart === oldValue.length) {
        target.setSelectionRange(newValue.length, newValue.length);
      }
    });

    phoneInput.addEventListener('paste', (e) => {
      const target = e.target as HTMLInputElement;
      setTimeout(() => {
        target.value = formatPhone(target.value);
      }, 0);
    });

    phoneInput.addEventListener('keydown', (e) => {
      const target = e.target as HTMLInputElement;
      if (e.key === 'Backspace' && target.value.length <= 4) {
        e.preventDefault();
      }
    });

    phoneInput.addEventListener('focus', (e) => {
      const target = e.target as HTMLInputElement;
      if (!target.value || target.value === '+7') {
        target.value = '+7 (';
      }
    });

    phoneInput.addEventListener('blur', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.value.length < 18) {
        target.value = '';
      }
    });
  }

  // === ОТПРАВКА ДАННЫХ В STRAPI ===
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form as HTMLFormElement);
    const data = {
      name: formData.get('name'),
      phone: formData.get('phone'),
      interest: formData.get('interest'),
      comment: formData.get('comment'),
    };

    try {
      const response = await fetch(`${import.meta.env.PUBLIC_STRAPI_URL}/api/leads`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ data }),
      });

      if (response.ok) {
        if(messageEl) {
          messageEl.textContent = 'Заявка успешно отправлена!';
          messageEl.className = 'form-message success';
        }
        (form as HTMLFormElement).reset();
        setTimeout(() => closeModal(), 2500);
      } else {
        throw new Error('Ошибка сервера');
      }
    } catch (error) {
      if(messageEl) {
        messageEl.textContent = 'Произошла ошибка. Попробуйте позже.';
        messageEl.className = 'form-message error';
      }
    }
  });

  setupModal();
</script>