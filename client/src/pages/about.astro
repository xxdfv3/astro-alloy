---
// src/pages/about.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PortfolioSlider from '../components/PortfolioSlider.astro';
---

<Layout title="О компании">
  <Header />

  <main class="about-page">
    <div class="container">

      <!-- Hero секция -->
      <section class="hero">
        <h1>О компании VZmarket</h1>
        <p class="hero-subtext">
          Производственная компания из Костаная, специализирующаяся на изготовлении котельного оборудования и предоставлении услуг металлообработки.
          Мы объединяем опытных специалистов, современное оборудование и высокие стандарты качества, чтобы обеспечивать клиентов надежными тепловыми решениями.
        </p>
        <p class="hero-subtext">
          В каталоге компании представлены как готовые решения, так и возможность разработки <span class="highlight">индивидуальных проектов</span> по вашему техническому заданию.
          Мы берем на себя <span class="highlight">полный цикл работ</span> — от проектирования и производства до доставки и установки изделий.
        </p>
      </section>

      <!-- Основные направления -->
      <section>
        <h2 class="section-title">Основные направления</h2>
        <div class="directions-grid">
          <div class="card">
            <h3>Производство и монтаж</h3>
            <p>Котельного оборудования любой сложности под ключ.</p>
          </div>
          <div class="card">
            <h3>Плазменная резка</h3>
            <p>Высокоточная резка металла на современном оборудовании с ЧПУ.</p>
          </div>
          <div class="card">
            <h3>Листогибочные работы</h3>
            <p>Изготовление деталей сложной геометрии с высокой точностью.</p>
          </div>
          <div class="card">
            <h3>Металлоконструкции</h3>
            <p>Производство металлических конструкций под заказ по вашим чертежам.</p>
          </div>
        </div>
      </section>

      <!-- Преимущества -->
      <section>
        <h2 class="section-title">Наши преимущества</h2>
        <div class="advantages-grid">
          <div class="advantage-card">
            <h3>20+ лет опыта</h3>
            <p>Глубокая экспертиза и эффективные решения для энергоснабжения промышленных объектов по всей стране.</p>
          </div>
          <div class="advantage-card">
            <h3>Высокая репутация</h3>
            <p>Регулярное участие в отраслевых выставках, награды и благодарности от клиентов.</p>
          </div>
          <div class="advantage-card">
            <h3>Команда профессионалов</h3>
            <p>Инженеры и техники с опытом более 20 лет, проходящие постоянное обучение.</p>
          </div>
          <div class="advantage-card">
            <h3>Широкий выбор оборудования</h3>
            <p>Котлы на угле, газе, биомассе, блочно-модульные котельные и паровые установки.</p>
          </div>
          <div class="advantage-card">
            <h3>Прямые поставки</h3>
            <p>Работаем напрямую с заказчиками, исключая посредников и лишние наценки.</p>
          </div>
          <div class="advantage-card">
            <h3>Современное производство</h3>
            <p>Автоматическая сварка, плазменная резка, станки с ЧПУ. 17 сварочных аппаратов и 25 кран-балок.</p>
          </div>
        </div>
      </section>

      <!-- Примеры наших работ -->
      <section>
        <h2 class="section-title">Примеры наших работ</h2>

        <PortfolioSlider
          images={[
            {
              src: '/images/portfolio/project.png',
              alt: 'Монтаж блочно-модульной котельной',
              title: 'Монтаж блочно-модульной котельной мощностью 2 МВт'
            },
            {
              src: '/images/portfolio/images.png',
              alt: 'Плазменная резка металла',
              title: 'Плазменная резка листового металла на станке с ЧПУ'
            },
            {
              src: '/images/portfolio/images1.png',
              alt: 'Изготовление металлоконструкций',
              title: 'Производство нестандартных металлоконструкций по чертежам заказчика'
            },
            {
              src: '/images/portfolio/welding-1.jpg',
              alt: 'Автоматическая сварка',
              title: 'Автоматическая сварка элементов парового котла'
            }
          ]}
        />
      </section>

      <!-- Сертификаты -->
      <section class="certificates-section">
        <h2 class="section-title" style="margin-top: 0;">Сертификаты и документация</h2>

        <p class="cert-description">
          Компания осуществляет деятельность в полном соответствии с действующими нормативами.
          Ниже представлен перечень сертификатов, лицензий и деклараций, подтверждающих качество оборудования
          и право на выполнение строительно-монтажных работ.
        </p>

        <!-- Категория 1 -->
        <details class="cert-category" open>
          <summary class="cert-summary">
            <div class="summary-inner">
              <h3>Сертификаты</h3>
              <svg class="icon-toggle" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </summary>
          <ul class="cert-list">
            <li class="cert-item">
              <span class="cert-name">Индустриальный сертификат</span>
              <a href="/docs/c1.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
            <li class="cert-item">
              <span class="cert-name">Лицензия на строительно-монтажные работы (III категория)</span>
              <a href="/docs/c2.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
            <li class="cert-item">
              <span class="cert-name">Разрешение на применение</span>
              <a href="/docs/c3.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
            <li class="cert-item">
              <span class="cert-name">ОД КВУ на ТОО</span>
              <a href="/docs/c4.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
            <li class="cert-item">
              <span class="cert-name">Патент №5039</span>
              <a href="/docs/c5.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
            <li class="cert-item">
              <span class="cert-name">ОД 6640 ТЗВК на ТОО</span>
              <a href="/docs/c6.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
            <li class="cert-item">
              <span class="cert-name">ОД 6522 БМВК на ТОО</span>
              <a href="/docs/c7.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
          </ul>
        </details>

        <!-- Категория 2 -->
        <details class="cert-category" open>
          <summary class="cert-summary">
            <div class="summary-inner">
              <h3>Декларации о соответствии</h3>
              <svg class="icon-toggle" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </summary>
          <ul class="cert-list">
            <li class="cert-item">
              <span class="cert-name">Блочно-модульная котельная</span>
              <a href="/docs/c8.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
            <li class="cert-item">
              <span class="cert-name">Дымосос ДН (до 15 000 м³/ч)</span>
              <a href="/docs/c9.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
            <li class="cert-item">
              <span class="cert-name">Котлы БМВК, КВУ, ТЗВК, КСТГ, КП</span>
              <a href="/docs/c10.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
            <li class="cert-item">
              <span class="cert-name">Экономайзер спаренный (от 800 до 1500)</span>
              <a href="/docs/c11.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
            <li class="cert-item">
              <span class="cert-name">Дымовая труба (до 1600)</span>
              <a href="/docs/c12.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
            <li class="cert-item">
              <span class="cert-name">Циклон ЦН-15</span>
              <a href="/docs/c13.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
          </ul>
        </details>

        <!-- Категория 3 -->
        <details class="cert-category" open>
          <summary class="cert-summary">
            <div class="summary-inner">
              <h3>Сертификаты соответствия</h3>
              <svg class="icon-toggle" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </summary>
          <ul class="cert-list">
            <li class="cert-item">
              <span class="cert-name">Дымосос / Дымовая труба</span>
              <a href="/docs/c14.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
            <li class="cert-item">
              <span class="cert-name">Циклон ЦН (2024)</span>
              <a href="/docs/c15.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
            <li class="cert-item">
              <span class="cert-name">Блочно-модульная котельная (2024)</span>
              <a href="/docs/c16.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
            <li class="cert-item">
              <span class="cert-name">CT KZ КВУ (от 26.11.2024)</span>
              <a href="/docs/c17.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
            <li class="cert-item">
              <span class="cert-name">БМВК (2024)</span>
              <a href="/docs/c18.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
          </ul>
        </details>
      </section>

      <!-- Заключение -->
      <section class="closing-section">
        <p class="hero-subtext">
          Мы работаем как с частными клиентами, так и с коммерческими организациями,
          обеспечивая высокое качество продукции и индивидуальный подход к каждому заказу.
          Наш приоритет – предоставлять клиентам продукцию и услуги, которые соответствуют
          реальным задачам и срокам.
        </p>
      </section>

    </div>
  </main>

  <Footer />
</Layout>

<style>
  .about-page {
    padding: 4rem 0;
    background-color: var(--bg-page);
  }

  .hero {
    text-align: center;
    margin-bottom: 4rem;
  }

  .hero h1 {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--accent-dark);
    margin-bottom: 1.5rem;
  }

  .hero-text {
    font-size: 1.125rem;
    color: var(--text-secondary);
    max-width: 900px;
    margin: 0 auto 1.5rem;
    line-height: 1.7;
  }

  .hero-subtext {
    font-size: 1.125rem;
    color: var(--text-primary);
    max-width: 900px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .highlight {
    color: var(--accent-orange);
    font-weight: 600;
  }

  .section-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--accent-dark);
    margin: 3rem 0 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--border-color);
  }

  /* Сетка направлений */
  .directions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 0.5rem;
    padding: 1.5rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .card h3 {
    color: var(--accent-dark);
    font-size: 1.125rem;
    margin-bottom: 0.75rem;
  }

  .card p {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Сетка преимуществ */
  .advantages-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .advantage-card {
    background: var(--bg-card);
    border-left: 4px solid var(--accent-green);
    border-radius: 0 0.5rem 0.5rem 0;
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
  }

  .advantage-card h3 {
    color: var(--text-primary);
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
  }

  .advantage-card p {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Секция сертификатов */
  .certificates-section {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 0.75rem;
    padding: 2.5rem;
    margin-top: 2rem;
    box-shadow: var(--shadow-sm);
  }

  .cert-description {
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
    line-height: 1.7;
    font-size: 1rem;
  }

  /* --- Стили для аккордеона <details> --- */
  .cert-category {
    margin-bottom: 1.5rem;
    border-bottom: 1px solid rgba(0,0,0,0.05);
    padding-bottom: 0.5rem;
  }

  .cert-category:last-child {
    margin-bottom: 0;
    border-bottom: none;
  }

  .cert-summary {
    cursor: pointer;
    list-style: none; /* Убирает стандартный треугольник */
    user-select: none;
    display: block; /* Важно: заставляет summary занимать всю ширину */
    width: 100%;
    outline: none;
  }

  /* Принудительно скрываем системные маркеры во всех браузерах */
  .cert-summary::marker,
  .cert-summary::-webkit-details-marker {
    display: none !important;
    content: "";
  }

  /* Обертка внутри summary для flexbox (решает баг в Safari) */
  .summary-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%; /* Растягивает контейнер на всю ширину summary */
    padding: 0.75rem 0;
    transition: color 0.2s ease;
  }

  /* Анимация при наведении на заголовок */
  .cert-summary:hover .summary-inner h3,
  .cert-summary:hover .summary-inner .icon-toggle {
    color: var(--accent-orange, #f97316); /* Подсветка при наведении */
  }

  .cert-category h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent-dark);
    margin: 0;
    transition: color 0.2s ease;
  }

  .icon-toggle {
    color: var(--accent-dark);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), color 0.2s ease;
  }

  /* Вращение иконки, когда details открыт */
  details[open] .icon-toggle {
    transform: rotate(180deg);
  }

  .cert-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    /* Анимация плавного появления */
    animation: slideFadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    transform-origin: top center;
  }

  @keyframes slideFadeIn {
    0% {
      opacity: 0;
      transform: translateY(-10px) scaleY(0.98);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scaleY(1);
    }
  }

  .cert-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.25rem;
    background: var(--bg-page);
    border-radius: 0.5rem;
    border: 1px solid var(--border-color);
    transition: border-color 0.2s, background-color 0.2s, transform 0.2s;
  }

  .cert-item:hover {
    border-color: var(--accent-dark);
    background-color: #FFFFFF;
    transform: translateX(4px); /* Легкий сдвиг вправо при наведении на карточку документа */
  }

  .cert-name {
    font-weight: 600;
    color: var(--text-primary);
    font-size: 1rem;
    padding-right: 1rem;
  }

  .btn-download {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--accent-dark);
    color: white;
    padding: 0.6rem 1.25rem;
    border-radius: 0.375rem;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: background-color 0.2s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .btn-download:hover {
    background-color: var(--accent-orange);
  }

  .closing-section {
    margin-top: 4rem;
    text-align: center;
  }

  .closing-text {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 900px;
    margin: 0 auto;
  }

  /* Адаптивность */
  @media (max-width: 768px) {
    .hero h1 {
      font-size: 2rem;
    }

    .cert-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .btn-download {
      width: 100%;
      justify-content: center;
    }

    .certificates-section {
      padding: 1.5rem;
    }
  }
</style>