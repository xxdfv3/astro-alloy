---
// src/pages/about.astro
import Layout from '../layouts/Layout.astro';
import PortfolioSlider from '../components/PortfolioSlider.astro';
---

<Layout title="О компании">

  <main class="about-page">
    <div class="container">

      <!-- Hero секция -->
      <section class="hero">
        <h1>О компании VZmarket</h1>
        <p class="hero-subtext">
          Производственная компания из Костаная, специализирующаяся на изготовлении котельного оборудования и предоставлении услуг металлообработки.
          Мы объединяем опытных специалистов, современное оборудование и высокие стандарты качества, чтобы обеспечивать клиентов надежными тепловыми решениями.
        </p>
        <p class="hero-subtext">
          В каталоге компании представлены как готовые решения, так и возможность разработки <span class="highlight">индивидуальных проектов</span> по вашему техническому заданию.
          Мы берем на себя <span class="highlight">полный цикл работ</span> — от проектирования и производства до доставки и установки изделий.
        </p>
      </section>

      <!-- Преимущества -->
      <section>
        <h2 class="section-title">Наши преимущества</h2>
        <div class="advantages-grid">
          <div class="advantage-card">
            <h3>Индивидуальный подбор оборудования</h3>
            <p>Учитываем потребность предприятия в тепле или паре, рабочие параметры и доступный вид топлива.</p>
          </div>
          <div class="advantage-card">
            <h3>Различные виды топлива</h3>
            <p>Решения для природного газа, угля, твёрдого и биотоплива.</p>
          </div>
          <div class="advantage-card">
            <h3>Комплексные котельные решения</h3>
            <p>Котлы, блочно-модульные котельные и сопутствующее оборудование.</p>
          </div>
          <div class="advantage-card">
            <h3>Доставка по Казахстану и СНГ</h3>
            <p>Организуем поставку оборудования до объекта заказчика.</p>
          </div>
          <div class="advantage-card">
            <h3>Техническое сопровождение</h3>
            <p>Консультируем на этапах подбора, поставки, монтажа и ввода оборудования в эксплуатацию.</p>
          </div>
          <div class="advantage-card">
            <h3>Контроль качества</h3>
            <p>Особое внимание уделяем качеству изготовления, сварочных соединений, сборки и готового оборудования.</p>
          </div>
        </div>
      </section>

      <!-- Примеры наших работ -->
      <section>
        <h2 class="section-title">Наши работы</h2>

        <PortfolioSlider
          images={[
            {
              src: '/images/portfolio/project.png',
              alt: 'Монтаж блочно-модульной котельной',
              title: 'Монтаж блочно-модульной котельной мощностью 2 МВт'
            },
            {
              src: '/images/portfolio/images.png',
              alt: 'Плазменная резка металла',
              title: 'Плазменная резка листового металла на станке с ЧПУ'
            },
            {
              src: '/images/portfolio/images1.png',
              alt: 'Изготовление металлоконструкций',
              title: 'Производство нестандартных металлоконструкций по чертежам заказчика'
            },
            {
              src: '/images/portfolio/welding-1.jpg',
              alt: 'Автоматическая сварка',
              title: 'Автоматическая сварка элементов парового котла'
            }
          ]}
        />
      </section>

      <!-- Сертификаты -->
      <section class="certificates-section">
        <h2 class="section-title" style="margin-top: 0;">Сертификаты и документация</h2>

        <p class="cert-description">
          Компания осуществляет деятельность в полном соответствии с действующими нормативами.
          Ниже представлен перечень сертификатов, лицензий и деклараций, подтверждающих качество оборудования
          и право на выполнение строительно-монтажных работ.
        </p>

        <!-- Категория 1 -->
        <details class="cert-category" open>
          <summary class="cert-summary">
            <div class="summary-inner">
              <h3>Сертификаты</h3>
              <svg class="icon-toggle" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </summary>
          <ul class="cert-list">
            <li class="cert-item">
              <span class="cert-name">Индустриальный сертификат</span>
              <a href="/docs/c1.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
            <li class="cert-item">
              <span class="cert-name">Лицензия на строительно-монтажные работы (III категория)</span>
              <a href="/docs/c2.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
            <li class="cert-item">
              <span class="cert-name">Разрешение на применение</span>
              <a href="/docs/c3.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
            <li class="cert-item">
              <span class="cert-name">ОД КВУ на ТОО</span>
              <a href="/docs/c4.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
            <li class="cert-item">
              <span class="cert-name">Патент №5039</span>
              <a href="/docs/c5.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
            <li class="cert-item">
              <span class="cert-name">ОД 6640 ТЗВК на ТОО</span>
              <a href="/docs/c6.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
            <li class="cert-item">
              <span class="cert-name">ОД 6522 БМВК на ТОО</span>
              <a href="/docs/c7.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
          </ul>
        </details>

        <!-- Категория 2 -->
        <details class="cert-category" open>
          <summary class="cert-summary">
            <div class="summary-inner">
              <h3>Декларации о соответствии</h3>
              <svg class="icon-toggle" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </summary>
          <ul class="cert-list">
            <li class="cert-item">
              <span class="cert-name">Блочно-модульная котельная</span>
              <a href="/docs/c8.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
            <li class="cert-item">
              <span class="cert-name">Дымосос ДН (до 15 000 м³/ч)</span>
              <a href="/docs/c9.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
            <li class="cert-item">
              <span class="cert-name">Котлы БМВК, КВУ, ТЗВК, КСТГ, КП</span>
              <a href="/docs/c10.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
            <li class="cert-item">
              <span class="cert-name">Экономайзер спаренный (от 800 до 1500)</span>
              <a href="/docs/c11.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
            <li class="cert-item">
              <span class="cert-name">Дымовая труба (до 1600)</span>
              <a href="/docs/c12.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
            <li class="cert-item">
              <span class="cert-name">Циклон ЦН-15</span>
              <a href="/docs/c13.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
          </ul>
        </details>

        <!-- Категория 3 -->
        <details class="cert-category" open>
          <summary class="cert-summary">
            <div class="summary-inner">
              <h3>Сертификаты соответствия</h3>
              <svg class="icon-toggle" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </summary>
          <ul class="cert-list">
            <li class="cert-item">
              <span class="cert-name">Дымосос / Дымовая труба</span>
              <a href="/docs/c14.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
            <li class="cert-item">
              <span class="cert-name">Циклон ЦН (2024)</span>
              <a href="/docs/c15.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
            <li class="cert-item">
              <span class="cert-name">Блочно-модульная котельная (2024)</span>
              <a href="/docs/c16.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
            <li class="cert-item">
              <span class="cert-name">CT KZ КВУ (от 26.11.2024)</span>
              <a href="/docs/c17.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
            <li class="cert-item">
              <span class="cert-name">БМВК (2024)</span>
              <a href="/docs/c18.pdf" class="btn-download" download>Скачать PDF</a>
            </li>
          </ul>
        </details>
      </section>

      <!-- Заключение -->
      <section class="closing-section">
        <p class="hero-subtext">
          Мы работаем как с частными клиентами, так и с коммерческими организациями,
          обеспечивая высокое качество продукции и индивидуальный подход к каждому заказу.
          Наш приоритет – предоставлять клиентам продукцию и услуги, которые соответствуют
          реальным задачам и срокам.
        </p>
      </section>

    </div>
  </main>

</Layout>

<style>
  /* =========================================
     1. ПЕРЕМЕННЫЕ (ИСПРАВЛЕНО: --about-h1-size вместо --h1-size)
     ========================================= */
  :root {
    --pad-x: 1rem;
    --section-pad-y: 2.5rem;
    --grid-gap: 1rem;
    --adv-cols: 1;
    --about-h1-size: 1.75rem; /* <-- ИСПРАВЛЕНО ЗДЕСЬ */
    --title-size: 1.5rem;
    --cert-pad: 1.5rem;
    --cert-item-pad: 1rem;
  }

  @media (min-width: 576px) {
    :root {
      --pad-x: 1.5rem;
      --section-pad-y: 3rem;
      --grid-gap: 1.25rem;
      --adv-cols: 2;
      --about-h1-size: 2rem; /* <-- ИСПРАВЛЕНО ЗДЕСЬ */
      --title-size: 1.625rem;
      --cert-pad: 2rem;
    }
  }

  @media (min-width: 768px) {
    :root {
      --pad-x: 2rem;
      --section-pad-y: 3.5rem;
      --grid-gap: 1.5rem;
      --title-size: 1.75rem;
      --cert-pad: 2.5rem;
      --cert-item-pad: 1.25rem;
    }
  }

  @media (min-width: 1024px) {
    :root {
      --pad-x: 2.5rem;
      --section-pad-y: 4rem;
      --grid-gap: 2rem;
      --adv-cols: 3;
      --about-h1-size: 2.5rem; /* <-- ИСПРАВЛЕНО ЗДЕСЬ */
      --title-size: 1.875rem;
    }
  }

  @media (min-width: 1280px) {
    :root {
      --pad-x: 3rem;
      --section-pad-y: 4.5rem;
      --grid-gap: 2.5rem;
      --about-h1-size: 2.75rem; /* <-- ИСПРАВЛЕНО ЗДЕСЬ */
    }
  }

  @media (min-width: 1600px) {
    :root {
      --pad-x: 4rem;
      --section-pad-y: 5rem;
      --grid-gap: 3rem;
      --about-h1-size: 3rem; /* <-- ИСПРАВЛЕНО ЗДЕСЬ */
      --title-size: 2rem;
      --cert-pad: 3rem;
    }
  }

  /* =========================================
     2. ПРИМЕНЕНИЕ СТИЛЕЙ
     ========================================= */
  
  .about-page {
    padding: var(--section-pad-y) 0;
    background-color: var(--bg-page, #F9FAFB);
  }

  .container {
    max-width: 1520px;
    margin: 0 auto;
    padding: 0 var(--pad-x);
  }

  .hero {
    text-align: center;
    margin-bottom: var(--section-pad-y);
  }

  .hero h1 {
    font-size: var(--about-h1-size); /* <-- ИСПРАВЛЕНО ЗДЕСЬ (используем новую переменную) */
    font-weight: 800;
    color: var(--accent-dark, #0F3D66);
    margin-bottom: 1.5rem;
    line-height: 1.2;
  }

  .hero-subtext {
    font-size: 1.0625rem;
    color: var(--text-primary, #374151);
    max-width: 900px;
    margin: 0 auto 1.5rem;
    line-height: 1.7;
  }

  .hero-subtext:last-child {
    margin-bottom: 0;
  }

  .highlight {
    color: var(--accent-orange, #C2410C);
    font-weight: 600;
  }

  .section-title {
    font-size: var(--title-size);
    font-weight: 700;
    color: var(--accent-dark, #0F3D66);
    margin: 0 0 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--border-color, #E5E7EB);
  }

  .advantages-grid {
    display: grid;
    grid-template-columns: repeat(var(--adv-cols), 1fr);
    gap: var(--grid-gap);
    margin-bottom: var(--section-pad-y);
  }

  .advantage-card {
    background: var(--bg-card, #FFFFFF);
    border-left: 4px solid var(--accent-green, #16A34A);
    border-radius: 0 0.5rem 0.5rem 0;
    padding: 1.5rem;
    box-shadow: var(--shadow-sm, 0 1px 2px rgba(0,0,0,0.05));
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    height: 100%;
    box-sizing: border-box;
  }

  .advantage-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md, 0 4px 6px rgba(0,0,0,0.1));
  }

  .advantage-card h3 {
    color: var(--text-primary, #111827);
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .advantage-card p {
    color: var(--text-secondary, #6B7280);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  .certificates-section {
    background: var(--bg-card, #FFFFFF);
    border: 1px solid var(--border-color, #E5E7EB);
    border-radius: 0.75rem;
    padding: var(--cert-pad);
    margin-top: 2rem;
    box-shadow: var(--shadow-sm, 0 1px 2px rgba(0,0,0,0.05));
  }

  .cert-description {
    color: var(--text-secondary, #6B7280);
    margin-bottom: 2.5rem;
    line-height: 1.7;
    font-size: 1rem;
  }

  .cert-category {
    margin-bottom: 1.5rem;
    border-bottom: 1px solid rgba(0,0,0,0.05);
    padding-bottom: 0.5rem;
  }

  .cert-category:last-child {
    margin-bottom: 0;
    border-bottom: none;
  }

  .cert-summary {
    cursor: pointer;
    list-style: none;
    user-select: none;
    display: block;
    width: 100%;
    outline: none;
  }

  .cert-summary::marker,
  .cert-summary::-webkit-details-marker {
    display: none !important;
    content: "";
  }

  .summary-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 0.75rem 0;
    transition: color 0.2s ease;
  }

  .cert-summary:hover .summary-inner h3,
  .cert-summary:hover .summary-inner .icon-toggle {
    color: var(--accent-orange, #C2410C);
  }

  .cert-category h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent-dark, #0F3D66);
    margin: 0;
    transition: color 0.2s ease;
  }

  .icon-toggle {
    color: var(--accent-dark, #0F3D66);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), color 0.2s ease;
    flex-shrink: 0;
    margin-left: 1rem;
  }

  details[open] .icon-toggle {
    transform: rotate(180deg);
  }

  .cert-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    animation: slideFadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    transform-origin: top center;
  }

  @keyframes slideFadeIn {
    0% { opacity: 0; transform: translateY(-10px) scaleY(0.98); }
    100% { opacity: 1; transform: translateY(0) scaleY(1); }
  }

  .cert-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--cert-item-pad);
    background: var(--bg-page, #F9FAFB);
    border-radius: 0.5rem;
    border: 1px solid var(--border-color, #E5E7EB);
    transition: border-color 0.2s, background-color 0.2s, transform 0.2s;
  }

  .cert-item:hover {
    border-color: var(--accent-dark, #0F3D66);
    background-color: #FFFFFF;
    transform: translateX(4px);
  }

  .cert-name {
    font-weight: 600;
    color: var(--text-primary, #111827);
    font-size: 1rem;
    padding-right: 1rem;
    line-height: 1.4;
  }

  .btn-download {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background-color: var(--accent-dark, #0F3D66);
    color: white;
    padding: 0.6rem 1.25rem;
    border-radius: 0.375rem;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: background-color 0.2s ease, transform 0.1s;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .btn-download:hover {
    background-color: var(--accent-orange, #C2410C);
  }

  .btn-download:active {
    transform: scale(0.97);
  }

  .closing-section {
    margin-top: var(--section-pad-y);
    text-align: center;
  }

  @media (max-width: 575px) {
    .cert-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .btn-download {
      width: 100%;
    }
  }
</style>