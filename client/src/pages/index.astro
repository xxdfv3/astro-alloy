---
// index.astro - Главная страница
import Layout from '../layouts/Layout.astro';
import ConsultationModal from '../components/ConsultationModal.astro';

const advantages = [
  {
    title: 'Надежное, сертифицированное оборудование',
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z'
  },
  {
    title: 'Полный комплекс работ "под ключ"',
    icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4'
  },
  {
    title: 'Экономия Вашего времени',
    icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z'
  },
  {
    title: 'Консультация квалифицированных специалистов',
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z'
  },
  {
    title: 'Высокое качество в сочетании с выгодными ценами',
    icon: 'M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z'

  }
];

const categories = [
  {
    title: 'Газовые котлы',
    description: 'Промышленные газовые котлы мощностью от 100 кВт до 10 МВт для отопления и технологических процессов',
    href: '/catalog/gas',
    image: '/images/boiler-gas.jpg'
  },
  {
    title: 'Паровые котлы',
    description: 'Паровые котлы для промышленных предприятий с производительностью от 0.5 до 25 тонн пара в час',
    href: '/catalog/steam',
    image: '/images/boiler-steam.jpg'
  },
  {
    title: 'Твердотопливные котлы',
    description: 'Котлы на твердом топливе для отопления зданий и обеспечения горячего водоснабжения',
    href: '/catalog/solid',
    image: '/images/boiler-solid.jpg'
  }
];
---

<Layout title="Главная">

  <!-- Hero секция -->
  <section class="hero">
    <div class="container">
      <div class="hero__content">
        <h1 class="hero__title">
          Газовые, паровые и твердотопливные котлы от производителя
        </h1>
        <p class="hero__subtitle">
          Производим надежное оборудование для промышленных предприятий, коммерческих объектов и частных заказчиков
        </p>
        <div class="hero__buttons">
          <a href="/catalog" class="btn btn--primary">Смотреть каталог</a>
          <button class="btn btn--secondary open-modal-btn" data-product="Консультация (главный экран)">
            Получить консультацию
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Почему нас выбирают -->
  <section class="advantages">
    <div class="container">
      <h2 class="section-title">Наши преимущества</h2>      
      <div class="advantages__grid">
        {advantages.map((adv) => (
          <div class="advantage-item">
            <svg class="advantage-icon" width="35" height="35" viewBox="0 0 24 24" fill="none" stroke="#EA0037" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={adv.icon} />
            </svg>
            <span class="advantage-text">{adv.title}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Категории товаров -->
  <section class="categories">
    <div class="container">
      <h2 class="section-title">Наши категории оборудования</h2>
      
      <div class="categories__grid">
        {categories.map((cat) => (
          <a href={cat.href} class="category-card">
            <div class="category-card__image" style={`background-image: url(${cat.image})`}>
            </div>
            <div class="category-card__content">
              <h3 class="category-card__title">{cat.title}</h3>
              <p class="category-card__description">{cat.description}</p>
              <span class="category-card__link">
                Подробнее
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>

      <div class="categories__more">
        <a href="/catalog" class="categories__more-btn">
          Остальные категории
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

    </div>
  </section>

  <!-- Секция с формой заявки -->
  <section class="contact-form">
    <div class="container">
      <div class="contact-form__wrapper" style="text-align: center;">
        <h2 class="contact-form__title">Остались вопросы?</h2>
        <p class="contact-form__subtitle">
          Оставьте заявку и наш специалист свяжется с вами в течение 15 минут
        </p>

        <button class="btn btn--primary open-modal-btn" data-product="Вопрос внизу главной страницы">
          Написать нам
        </button>

        <p class="form__privacy" style="margin-top: 1rem;">
          Нажимая кнопку, вы соглашаетесь с
          <a href="/privacy"> политикой конфиденциальности</a>
        </p>
      </div>
    </div>
  </section>

  <ConsultationModal />

</Layout>

<style>
  :root {
    --container-max: 100%;
    --container-pad-x: 1rem;
    --section-pad-y: 26px; 
    --hero-title-size: 1.75rem;
    --hero-subtitle-size: 1rem;
    --section-title-size: 1.5rem;
    --adv-cols: 1;
    --cat-cols: 1;
    --form-pad: 1.5rem;
    --grid-gap: 1.5rem;
  }

  @media (min-width: 576px) {
    :root {
      --container-pad-x: 1.5rem;
      --section-pad-y: 26px;
      --hero-title-size: 2rem;
      --hero-subtitle-size: 1.125rem;
      --section-title-size: 1.75rem;
      --cat-cols: 2;
      --form-pad: 2rem;
      --grid-gap: 1.5rem;
    }
  }

  @media (min-width: 768px) {
    :root {
      --container-pad-x: 2rem;
      --section-pad-y: 26px;
      --container-max: 768px;
      --hero-title-size: 2.25rem;
      --section-title-size: 2rem;
      --adv-cols: 2;
      --grid-gap: 2rem;
    }
  }

  @media (min-width: 1024px) {
    :root {
      --container-pad-x: 2.5rem;
      --section-pad-y: 26px;
      --container-max: 1024px;
      --hero-title-size: 2.5rem;
      --section-title-size: 2.25rem;
      --adv-cols: 3;
      --cat-cols: 3;
      --grid-gap: 2rem;
    }
  }

  @media (min-width: 1280px) {
    :root {
      --container-pad-x: 3rem;
      --section-pad-y: 26px;
      --container-max: 1280px;
      --hero-title-size: 2.75rem;
      --section-title-size: 2.5rem;
      --grid-gap: 2.5rem;
    }
  }

  @media (min-width: 1600px) {
    :root {
      --container-pad-x: 4rem;
      --section-pad-y: 26px;
      --container-max: 1520px;
      --hero-title-size: 3rem;
      --section-title-size: 2.75rem;
      --grid-gap: 3rem;
    }
  }
  
  .hero {
    background: linear-gradient(135deg, #0F3D66 0%, #0B2E4D 100%);
    color: white;
    padding: var(--section-pad-y) 0;
  }

  .advantages,
  .categories,
  .contact-form {
    padding: var(--section-pad-y) 0;
  }

  .categories {
    background-color: #F5F7FA;
  }

  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-pad-x);
    font-family: 'PT Astra Sans', 'Liberation Sans', system-ui, -apple-system, sans-serif;
  }

  .section-title {
    font-size: var(--section-title-size);
    font-weight: 800;
    text-align: center !important;
    color: #111827;
    margin-bottom: var(--section-pad-y);
    letter-spacing: -0.02em;
  }

  .categories .section-title {
    margin-bottom: 26px; 
  }

  .hero__content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .hero__title {
    font-size: var(--hero-title-size);
    font-weight: 800;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .hero__subtitle {
    font-size: var(--hero-subtitle-size);
    color: #E5E7EB;
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .hero__buttons {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: center;
  }

  @media (min-width: 576px) {
    .hero__buttons {
      flex-direction: row;
    }
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 1.75rem;
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 1.125rem;
    text-decoration: none;
    text-align: center;
    transition: all 0.2s;
    border: none;
    cursor: pointer;
    min-height: 48px;
  }

  .btn--primary {
    background-color: #C2410C;
    color: white;
  }

  .btn--primary:hover {
    background-color: #9A3412;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(194, 65, 12, 0.3);
  }

  .btn--secondary {
    background-color: white;
    color: #0F3D66;
  }

  .btn--secondary:hover {
    background-color: #F3F4F6;
    transform: translateY(-2px);
  }

  .advantages__grid {
    display: grid;
    grid-template-columns: repeat(var(--adv-cols), 1fr);
    gap: var(--grid-gap);
  }

  .advantage-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background: #FFFFFF;
    padding: 1.5rem;
    border-radius: 0.75rem;
    border: 1px solid #E5E7EB;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .advantage-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.06);
  }

  .advantage-icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    stroke: #EA0037;
  }

  .advantage-text {
    font-size: 1.05rem;
    font-weight: 600;
    color: #111827;
    line-height: 1.4;
    padding-top: 0.2rem;
  }

  .categories__grid {
    display: grid;
    grid-template-columns: repeat(var(--cat-cols), 1fr);
    gap: var(--grid-gap);
  }

  .category-card {
    background-color: #FFFFFF;
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    border: 1px solid #DCE3EB;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.3s, transform 0.3s;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .category-card:hover {
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
    transform: translateY(-6px);
    border-color: #C2410C;
  }

  .category-card__image {
    height: 16rem; /* Увеличили высоту */
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background-size: contain !important; /* Показываем весь котел */
    background-position: center !important;
    background-repeat: no-repeat !important;
    background-color: #F8FAFC; /* Светлый фон для контраста */
  }

  .category-card__content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .category-card__title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #111827;
    margin-bottom: 0.5rem;
    transition: color 0.2s;
  }

  .category-card:hover .category-card__title {
    color: #0B2E4D;
  }

  .category-card__description {
    color: #5A6B7B;
    margin-bottom: 1.5rem;
    line-height: 1.5;
    font-size: 0.95rem;
    flex-grow: 1;
  }

  .category-card__link {
    color: #C2410C;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
  }

  .category-card:hover .category-card__link svg {
    transform: translateX(0.25rem);
    transition: transform 0.3s;
  }

  .categories__more {
    display: flex;
    justify-content: center;
    margin-top: 26px;
  }

  .categories__more-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #C2410C;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    padding: 0.75rem 1.5rem;
    background-color: #FFFFFF;
    border: 1px solid #DCE3EB;
    border-radius: 0.5rem;
    transition: all 0.3s ease;
  }

  .categories__more-btn svg {
    transition: transform 0.3s ease;
  }

  .categories__more-btn:hover {
    gap: 0.75rem;
    background-color: #FFF7ED;
    border-color: #C2410C;
  }

  .categories__more-btn:hover svg {
    transform: translateX(4px);
  }

  .contact-form__wrapper {
    max-width: 600px;
    margin: 0 auto;
    background-color: white;
    border-radius: 0.75rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    border: 1px solid #DCE3EB;
    padding: var(--form-pad);
  }

  .contact-form__title {
    font-size: 1.5rem;
    font-weight: 700;
    text-align: center;
    color: #111827;
    margin-bottom: 0.5rem;
  }

  .contact-form__subtitle {
    text-align: center;
    color: #5A6B7B;
    margin-bottom: 1.5rem;
    font-size: 1rem;
    line-height: 1.5;
  }

  .form__privacy {
    font-size: 0.8rem;
    color: #6B7280;
    text-align: center;
    margin-top: 1rem;
    line-height: 1.4;
  }

  .form__privacy a {
    color: #0F3D66;
    text-decoration: none;
    font-weight: 500;
  }

  .form__privacy a:hover {
    text-decoration: underline;
  }
</style>