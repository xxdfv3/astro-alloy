---
// index.astro - Главная страница
import Layout from '../layouts/Layout.astro';
import ConsultationModal from '../components/ConsultationModal.astro';

const advantages = [
  {
    title: 'Надежное, сертифицированное оборудование',
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z'
  },
  {
    title: 'Полный комплекс работ "под ключ"',
    icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4'
  },
  {
    title: 'Высокое качество в сочетании с выгодными ценами',
    icon: 'M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z'
  },
  {
    title: 'Консультация квалифицированных специалистов',
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z'
  },
  {
    title: 'Экономия Вашего времени',
    icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z'
  }
];

const categories = [
  {
    title: 'Газовые котлы',
    description: 'Промышленные газовые котлы мощностью от 100 кВт до 10 МВт для отопления и технологических процессов',
    href: '/catalog/gas',
    gradient: 'linear-gradient(135deg, #0F3D66 0%, #0B2E4D 100%)',
    icon: 'M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z'
  },
  {
    title: 'Паровые котлы',
    description: 'Паровые котлы для промышленных предприятий с производительностью от 0.5 до 25 тонн пара в час',
    href: '/catalog/steam',
    gradient: 'linear-gradient(135deg, #C2410C 0%, #9A3412 100%)',
    icon: 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z'
  },
  {
    title: 'Твердотопливные котлы',
    description: 'Котлы на твердом топливе для отопления зданий и обеспечения горячего водоснабжения',
    href: '/catalog/solid',
    gradient: 'linear-gradient(135deg, #15803D 0%, #166534 100%)',
    icon: 'M13 10V3L4 14h7v7l9-11h-7z'
  }
];
---

<Layout title="Главная">

  <!-- Hero секция -->
  <section class="hero">
    <div class="container">
      <div class="hero__content">
        <h1 class="hero__title">
          Газовые, паровые и твердотопливные котлы от производителя
        </h1>
        <p class="hero__subtitle">
          Производим надежное оборудование для промышленных предприятий, коммерческих объектов и частных заказчиков
        </p>
        <div class="hero__buttons">
          <a href="/catalog" class="btn btn--primary">Смотреть каталог</a>
          <button id="open-modal-btn" class="btn btn--secondary" data-product="Консультация (главный экран)">Получить консультацию</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Почему нас выбирают -->
  <section class="advantages">
    <div class="container">
      <h2 class="section-title">Наши преимущества</h2>      
      <div class="advantages__grid">
        {advantages.map((adv) => (
          <div class="advantage-item">
            <svg class="advantage-icon" width="35" height="35" viewBox="0 0 24 24" fill="none" stroke="#EA0037" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={adv.icon} />
            </svg>
            <span class="advantage-text">{adv.title}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Категории товаров -->
  <section class="categories">
    <div class="container">
      <h2 class="section-title">Наши категории оборудования</h2>
      <div class="categories__grid">
        {categories.map((cat) => (
          <a href={cat.href} class="category-card">
            <div class="category-card__image" style={`background: ${cat.gradient}`}>
              <svg width="96" height="96" viewBox="0 0 24 24" fill="none" stroke="white">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={cat.icon} />
              </svg>
            </div>
            <div class="category-card__content">
              <h3 class="category-card__title">{cat.title}</h3>
              <p class="category-card__description">{cat.description}</p>
              <span class="category-card__link">
                Подробнее
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Секция с формой заявки -->
  <section class="contact-form">
    <div class="container">
      <div class="contact-form__wrapper" style="text-align: center;">
        <h2 class="contact-form__title">Остались вопросы?</h2>
        <p class="contact-form__subtitle">
          Оставьте заявку и наш специалист свяжется с вами в течение 15 минут
        </p>

        <button id="open-modal-btn" class="btn btn--primary" data-product="Вопрос внизу главной страницы">
          Написать нам
        </button>

        <p class="form__privacy" style="margin-top: 1rem;">
          Нажимая кнопку, вы соглашаетесь с
          <a href="/privacy"> политикой конфиденциальности</a>
        </p>
      </div>
    </div>
  </section>

  <ConsultationModal />
</Layout>

<style>

  .hero {
    background: linear-gradient(135deg, #0F3D66 0%, #0B2E4D 100%);
    color: white;
    padding: 4rem 0; /* Уменьшено с 6rem */
  }

  .advantages,
  .categories,
  .contact-form {
    padding: 2.5rem 0; /* Уменьшено с 5rem до 2.5rem для компактности */
  }

  .categories {
    background-color: #F5F7FA;
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-title {
    font-size: 2rem;
    font-weight: bold;
    text-align: center !important;
    color: #111827;
    margin-bottom: 2.5rem;
  }

  .section-subtitle {
    font-size: 1.125rem;
    color: #5A6B7B;
    margin-bottom: 3rem; /* Увеличено с 2rem до 3rem */
    text-align: center !important;
  }

  /* Специфичный отступ для заголовка категорий */
  .categories .section-title {
    margin-bottom: 3rem; /* Увеличено с 0.5rem до 3rem */
  }

  .hero__content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .hero__title {
    font-size: 2.5rem;
    font-weight: bold;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .hero__subtitle {
    font-size: 1.25rem;
    color: #E5E7EB;
    margin-bottom: 2rem;
  }

  .hero__buttons {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: center;
  }

  .btn {
    display: inline-block;
    padding: 0.875rem 1.75rem; /* Чуть компактнее */
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 1.125rem;
    text-decoration: none;
    text-align: center;
    transition: all 0.2s;
    border: none;
    cursor: pointer;
  }

  .btn--primary {
    background-color: #C2410C;
    color: white;
  }

  .btn--primary:hover {
    background-color: #9A3412;
  }

  .btn--secondary {
    background-color: white;
    color: #0F3D66;
  }

  .btn--secondary:hover {
    background-color: #F3F4F6;
  }

  .btn--full {
    width: 100%;
  }

  .advantages__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 2rem; /* Уменьшено с 2.5rem */
  }

  .advantage-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    flex: 0 1 calc(33.333% - 1.34rem); /* Пересчитано под новый gap */
    min-width: 280px;
  }

  .advantage-icon {
    flex-shrink: 0;
    width: 36px; /* Чуть компактнее */
    height: 36px;
    stroke: #EA0037;
  }

  .advantage-text {
    font-size: 1.05rem;
    font-weight: 500;
    color: #111827;
    line-height: 1.4;
    padding-top: 0.2rem;
  }

  .categories__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem; /* Уменьшено с 2rem */
  }

  .category-card {
    background-color: #FFFFFF;
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    border: 1px solid #DCE3EB;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.3s, transform 0.3s;
  }

  .category-card:hover {
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08);
    transform: translateY(-4px);
  }

  .category-card__image {
    height: 12rem; /* Вернул к 12rem для компактности */
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .category-card__content {
    padding: 1.25rem; /* Уменьшено с 1.5rem */
  }

  .category-card__title {
    font-size: 1.25rem;
    font-weight: bold;
    color: #111827;
    margin-bottom: 0.5rem;
    transition: color 0.2s;
  }

  .category-card:hover .category-card__title {
    color: #0B2E4D;
  }

  .category-card__description {
    color: #5A6B7B;
    margin-bottom: 1rem;
    line-height: 1.5;
    font-size: 0.95rem;
  }

  .category-card__link {
    color: #C2410C;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
  }

  .category-card:hover .category-card__link svg {
    transform: translateX(0.25rem);
    transition: transform 0.3s;
  }

  .contact-form__wrapper {
    max-width: 600px;
    margin: 0 auto;
    background-color: white;
    border-radius: 0.75rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    border: 1px solid #DCE3EB;
    padding: 2rem; /* Уменьшено с 3rem */
  }

  .contact-form__title {
    font-size: 1.5rem; /* Чуть компактнее */
    font-weight: bold;
    text-align: center;
    color: #111827;
    margin-bottom: 0.5rem;
  }

  .contact-form__subtitle {
    text-align: center;
    color: #5A6B7B;
    margin-bottom: 1.5rem; /* Уменьшено с 2.5rem */
    font-size: 1rem;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 1rem; /* Уменьшено с 1.25rem */
  }

  .form__group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .form__label {
    font-size: 0.875rem;
    font-weight: 600;
    color: #111827;
  }

  .form__input,
  .form__textarea {
    padding: 0.75rem 1rem;
    border: 1px solid #DCE3EB;
    border-radius: 0.5rem;
    font-size: 1rem;
    font-family: inherit;
    transition: border-color 0.2s, box-shadow 0.2s;
    background-color: #F9FAFB;
  }

  .form__input:focus,
  .form__textarea:focus {
    outline: none;
    border-color: #0F3D66;
    box-shadow: 0 0 0 3px rgba(15, 61, 102, 0.1);
    background-color: #FFFFFF;
  }

  .form__textarea {
    resize: vertical;
    min-height: 100px;
  }

  .form__privacy {
    font-size: 0.75rem;
    color: #6B7280;
    text-align: center;
    margin-top: 0.75rem;
  }

  .form__privacy a {
    color: #0F3D66;
    text-decoration: none;
  }

  .form__privacy a:hover {
    text-decoration: underline;
  }


  @media (min-width: 640px) {
    .hero__buttons {
      flex-direction: row;
    }
    .hero__title {
      font-size: 2.25rem;
    }
  }

  @media (max-width: 1024px) {
    .advantage-item {
      flex: 0 1 calc(50% - 1rem);
    }
  }

  @media (max-width: 640px) {
    .hero { padding: 3rem 0; }
    
    .advantages, .categories, .contact-form {
      padding: 2rem 0; /* Компактно на мобильных */
    }

    .advantage-item {
      flex: 0 1 100%;
      min-width: auto;
    }

    .section-title { font-size: 1.5rem; }
    .section-subtitle { font-size: 1rem; margin-bottom: 1.5rem; }

    .contact-form__wrapper {
      padding: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .categories__grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .section-title {
      font-size: 2.25rem;
    }
  }
</style>
