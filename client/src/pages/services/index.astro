---
// src/pages/index.astro - Страница услуг
import Layout from '../../layouts/Layout.astro';
import { servicesData } from '../../data/services.js';

// Преобразуем объект услуг в массив с формированием ссылки и описания
const services = Object.entries(servicesData).map(([slug, service]) => ({
  ...service,
  slug,
  href: `/services/${slug}`,
  description: service.shortDesc,
}));
---

<Layout title="Наши услуги | VZmarket">

  <!-- Hero секция для страницы услуг -->
  <section class="hero">
    <div class="container">
      <div class="hero__content">
        <h1 class="hero__title">Наши услуги</h1>
        <p class="hero__subtitle">
          Предоставляем полный спектр услуг по обработке металла и изготовлению оборудования для вашего бизнеса
        </p>
      </div>
    </div>
  </section>

  <!-- Сетка услуг -->
  <section class="services-section">
    <div class="container">
      <div class="services__grid">
        {services.map((service) => (
          <a href={service.href} class="service-card">
            <div class="service-card__image-wrapper">
              <img
                src={service.image}
                alt={service.title}
                class="service-card__image"
                loading="lazy"
              />
            </div>
            <div class="service-card__content">
              <h3 class="service-card__title">{service.title}</h3>
              <p class="service-card__description">{service.description}</p>
              <span class="service-card__link">
                Подробнее об услуге
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

</Layout>

<style>
  /* Hero секция (компактная) */
  .hero {
    background: linear-gradient(135deg, #0F3D66 0%, #0B2E4D 100%);
    color: white;
    padding: 4rem 0;
  }

  .hero__content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .hero__title {
    font-size: 2.5rem;
    font-weight: bold;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .hero__subtitle {
    font-size: 1.125rem;
    color: #E5E7EB;
    line-height: 1.6;
  }

  /* Секция услуг */
  .services-section {
    padding: 4rem 0;
    background-color: #F5F7FA;
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Сетка услуг: Flex для идеального центрирования 4-й карточки */
  .services__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
  }

  /* Карточка услуги */
  .service-card {
    flex: 0 1 calc(33.333% - 1.34rem);
    min-width: 300px;
    background-color: #FFFFFF;
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    border: 1px solid #DCE3EB;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.3s ease, transform 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .service-card:hover {
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
    transform: translateY(-6px);
  }

  .service-card__image-wrapper {
    width: 100%;
    height: 14rem;
    overflow: hidden;
    background-color: #E5E7EB;
  }

  .service-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .service-card:hover .service-card__image {
    transform: scale(1.05);
  }

  .service-card__content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .service-card__title {
    font-size: 1.35rem;
    font-weight: bold;
    color: #111827;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .service-card__description {
    color: #5A6B7B;
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .service-card__link {
    color: #C2410C;
    font-weight: 600;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: gap 0.3s ease;
  }

  .service-card:hover .service-card__link {
    gap: 0.75rem;
  }

  /* Адаптивность */
  @media (max-width: 1024px) {
    .service-card {
      flex: 0 1 calc(50% - 1rem);
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 3rem 0;
    }

    .hero__title {
      font-size: 1.75rem;
    }

    .hero__subtitle {
      font-size: 1rem;
    }

    .services-section {
      padding: 2.5rem 0;
    }

    .service-card {
      flex: 0 1 100%;
      min-width: auto;
    }
  }

  @media (min-width: 1024px) {
    .hero__title {
      font-size: 3rem;
    }
  }
</style>