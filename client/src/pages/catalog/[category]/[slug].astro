---
import Layout from '../../../layouts/Layout.astro';

// 1. Получаем все товары с привязанными категориями и картинками для генерации ссылок
export async function getStaticPaths() {
  const response = await fetch(`${import.meta.env.PUBLIC_STRAPI_URL}/api/products?populate=*`);
  const json = await response.json();
  const products = json.data;

  return products.map((product) => {
    const categorySlug = product.category?.slug || 'uncategorized';

    return {
      params: { category: categorySlug, slug: product.slug },
      props: { product },
    };
  });
}

// 2. Получаем данные конкретного товара из props
const { product } = Astro.props;
const { category } = Astro.params;

// Распаковываем нужные поля
const { title, price, power, area, efficiency, fuel_consumption, image } = product;
const imageUrl = image?.url ? `${import.meta.env.PUBLIC_STRAPI_URL}${image.url}` : '/placeholder.jpg';
const categoryTitle = product.category?.title || 'Категория';

// Проверяем наличие хотя бы одной характеристики
const hasSpecs = power || area || efficiency || fuel_consumption;
---

<Layout title={title}>
  <main class="product-container">

    {/* Хлебные крошки */}
    <nav class="breadcrumbs">
      <a href="/catalog">Каталог</a>
      <span class="breadcrumbs-separator">&gt;</span>
      <a href={`/catalog/${category}`}>{categoryTitle}</a>
      <span class="breadcrumbs-separator">&gt;</span>
      <span class="breadcrumbs-current">{title}</span>
    </nav>

    {/* Основной двухколоночный блок */}
    <div class="product-layout">

      {/* Левая колонка - Изображение */}
      <div class="product-image-column">
        <div class="product-image-wrapper">
          <span class="status-badge">В наличии</span>
          {image?.url ? (
            <img src={imageUrl} alt={title} class="product-image" />
          ) : (
            <span class="no-image-text">Нет фото</span>
          )}
        </div>
      </div>

      {/* Правая колонка - Информация */}
      <div class="product-info-column">
        <h1 class="product-title">{title}</h1>

        <p class="product-price">
          {price ? `от ${price.toLocaleString('ru-RU')} ₸` : 'Цена по запросу'}
        </p>

        {hasSpecs && (
          <div class="product-specs">
            <h3 class="specs-title">Характеристики:</h3>

            {power && (
              <div class="spec-row">
                <span class="spec-label">Мощность</span>
                <span class="spec-value">{power}</span>
              </div>
            )}

            {area && (
              <div class="spec-row">
                <span class="spec-label">Отапливаемая площадь</span>
                <span class="spec-value">{area}</span>
              </div>
            )}

            {efficiency && (
              <div class="spec-row">
                <span class="spec-label">КПД</span>
                <span class="spec-value">{efficiency}</span>
              </div>
            )}

            {fuel_consumption && (
              <div class="spec-row">
                <span class="spec-label">Расход топлива</span>
                <span class="spec-value">{fuel_consumption}</span>
              </div>
            )}
          </div>
        )}

        {/* Кнопка заявки, которая вызывает ConsultationModal */}
        <button
          id="open-modal-btn"
          class="btn-order-large"
          data-product={title}
        >
          Заказать консультацию
        </button>
      </div>
    </div>
  </main>
</Layout>

<style>
  /* Контейнер страницы */
  .product-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
    font-family: sans-serif;
  }

  /* Хлебные крошки */
  .breadcrumbs {
    margin-bottom: 2rem;
    font-size: 0.9rem;
    color: #6b7280;
  }
  .breadcrumbs a {
    color: #111827;
    text-decoration: none;
    transition: color 0.2s;
  }
  .breadcrumbs a:hover {
    text-decoration: underline;
    color: #C2410C;
  }
  .breadcrumbs-separator {
    margin: 0 0.5rem;
    color: #9ca3af;
  }
  .breadcrumbs-current {
    color: #6b7280;
  }

  /* Основная сетка: 1 колонка на мобильных, 2 на десктопе */
  .product-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 768px) {
    .product-layout {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  /* Изображение */
  .product-image-wrapper {
    position: relative;
    background-color: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    padding: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 300px;
  }

  .status-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background-color: #16A34A;
    color: white;
    font-size: 0.85rem;
    font-weight: bold;
    padding: 0.35rem 1rem;
    border-radius: 9999px;
  }

  .product-image {
    max-width: 100%;
    height: auto;
    max-height: 400px;
    object-fit: contain;
  }

  .no-image-text {
    color: #9ca3af;
    font-size: 1.1rem;
  }

  /* Информация */
  .product-title {
    font-size: 2.25rem;
    font-weight: bold;
    color: #111827;
    margin: 0 0 1rem 0;
    line-height: 1.2;
  }

  .product-price {
    font-size: 2rem;
    font-weight: bold;
    color: #C2410C;
    margin: 0 0 2rem 0;
  }

  /* Характеристики */
  .product-specs {
    margin-bottom: 2.5rem;
  }

  .specs-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: #111827;
    margin: 0 0 1rem 0;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #e5e7eb;
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    padding: 0.75rem 0;
    border-bottom: 1px solid #e5e7eb;
    font-size: 1rem;
  }

  .spec-label {
    color: #4b5563;
  }

  .spec-value {
    color: #111827;
    font-weight: 500;
    text-align: right;
  }

  /* Кнопка заявки */
  .btn-order-large {
    display: inline-block;
    width: 100%;
    background-color: #C2410C;
    color: white;
    padding: 1rem 2rem;
    font-size: 1.125rem;
    font-weight: 600;
    text-align: center;
    border: none;
    border-radius: 0.5rem;
    cursor: pointer;
    font-family: inherit;
    transition: background-color 0.2s;
  }

  .btn-order-large:hover {
    background-color: #9A3412;
  }

  @media (min-width: 768px) {
    .btn-order-large {
      width: auto;
      min-width: 250px;
    }
  }
</style>