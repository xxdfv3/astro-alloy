---
import Layout from '../../layouts/Layout.astro';

// Запрашиваем категории из Strapi
const response = await fetch(`${import.meta.env.PUBLIC_STRAPI_URL}/api/categories?populate=*`);
const json = await response.json();
const categories = json.data;
---

<Layout title="Каталог продукции">
  <main class="catalog-container">
    <h1 class="catalog-title">Каталог продукции</h1>

    {/* Сетка категорий */}
    <div class="catalog-grid">

      {categories.map((category: { title: any; slug: any; image: any; }) => {
        const { title, slug, image } = category;

        // Формируем URL для картинки
        const imageUrl = image?.url ? `${import.meta.env.PUBLIC_STRAPI_URL}${image.url}` : '/placeholder.jpg';

        return (
          <a href={`/catalog/${slug}`} class="category-card">
            <div class="category-card__image-wrapper">
              <img src={imageUrl} alt={title} class="category-card__image" />
            </div>
            <h2 class="category-card__title">{title}</h2>
          </a>
        );
      })}

    </div>
  </main>
</Layout>

<style>
  /* =========================================
     1. ПЕРЕМЕННЫЕ ПОД 6 РАЗМЕРОВ ЭКРАНА
     ========================================= */
  :root {
    /* XS: 375px (Мобильные) */
    --container-pad-x: 1rem;
    --container-pad-y: 2rem;
    --grid-gap: 1rem;
    --grid-cols: 1;
    --grid-max-width: 100%;
    --title-size: 1.75rem;
    --title-mb: 2rem;
    --card-pad: 1rem;
    --img-wrapper-h: 10rem;
  }

  /* SM: 576px (Большие мобильные) */
  @media (min-width: 576px) {
    :root {
      --container-pad-x: 1.5rem;
      --container-pad-y: 2.5rem;
      --grid-gap: 1.5rem;
      --grid-max-width: 600px;
      --title-size: 2rem;
      --img-wrapper-h: 12rem;
    }
  }

  /* MD: 768px (Планшеты) */
  @media (min-width: 768px) {
    :root {
      --container-pad-x: 2rem;
      --container-pad-y: 3rem;
      --grid-gap: 2rem;
      --grid-cols: 2;
      --grid-max-width: 700px;
      --title-size: 2.25rem;
      --title-mb: 3rem;
    }
  }

  /* LG: 1024px (Ноутбуки) */
  @media (min-width: 1024px) {
    :root {
      --container-pad-x: 2.5rem;
      --grid-gap: 2.5rem;
      --grid-cols: 3; /* Максимум 3 колонки для солидного вида */
      --grid-max-width: 960px;
      --img-wrapper-h: 14rem; /* Увеличиваем высоту картинок на десктопе */
    }
  }

  /* XL: 1280px (Стандартный десктоп) */
  @media (min-width: 1280px) {
    :root {
      --container-pad-x: 3rem;
      --container-pad-y: 4rem;
      --grid-gap: 3rem;
      --grid-max-width: 1100px;
      --title-size: 2.5rem;
    }
  }

  /* XXL: 1600px+ (Большие мониторы) */
  @media (min-width: 1600px) {
    :root {
      --container-pad-x: 4rem;
      --grid-max-width: 1200px; /* Ограничиваем ширину, чтобы карточки не расплывались, а оставались крупными */
    }
  }

  /* =========================================
     2. ПРИМЕНЕНИЕ СТИЛЕЙ
     ========================================= */
  
  /* Контейнер страницы */
  .catalog-container {
    max-width: 1520px; /* Абсолютный максимум для XXL */
    margin: 0 auto;
    padding: var(--container-pad-y) var(--container-pad-x);
    font-family: 'PT Astra Sans', 'Liberation Sans', system-ui, -apple-system, sans-serif;
    min-height: 60vh;
  }

  /* Заголовок страницы */
  .catalog-title {
    font-size: var(--title-size);
    font-weight: 800;
    text-align: center;
    color: #111827;
    margin-bottom: var(--title-mb);
    letter-spacing: -0.02em;
  }

  /* Сетка карточек */
  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-cols), 1fr);
    gap: var(--grid-gap);
    max-width: var(--grid-max-width);
    margin: 0 auto;
  }

  /* Внешний вид карточки */
  .category-card {
    display: flex;
    flex-direction: column;
    background-color: #F3F4F6; /* Чуть светлее и современнее, чем #E2E2E2 */
    border-radius: 0.75rem;
    padding: var(--card-pad);
    text-decoration: none;
    color: #000;
    transition: transform 0.3s ease, box-shadow 0.3s ease, background-color 0.3s ease;
    height: 100%; /* Чтобы карточки в ряду были одной высоты */
    box-sizing: border-box;
  }

  .category-card:hover {
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
    transform: translateY(-6px);
    background-color: #ffffff;
  }

  /* Контейнер для изображений */
  .category-card__image-wrapper {
    height: var(--img-wrapper-h);
    background-color: #ffffff;
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    padding: 1rem;
    transition: background-color 0.3s ease;
    overflow: hidden;
  }

  .category-card:hover .category-card__image-wrapper {
    background-color: #F9FAFB;
  }

  .category-card__image {
    max-height: 100%;
    max-width: 100%;
    object-fit: contain;
    transition: transform 0.4s ease;
  }

  .category-card:hover .category-card__image {
    transform: scale(1.05); /* Легкое увеличение картинки при наведении */
  }

  /* Название категории */
  .category-card__title {
    font-size: 1.25rem;
    font-weight: 700;
    text-align: center;
    color: #111827;
    margin: 0;
    transition: color 0.2s ease;
    line-height: 1.3;
  }

  .category-card:hover .category-card__title {
    color: #C2410C; /* Фирменный оранжевый цвет при наведении */
  }
</style>